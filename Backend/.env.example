# ==============================================================================
# FiringSim Backend Environment Configuration
# ==============================================================================

# Backend Server Host and HTTP Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# UDP Listener Host and Port (Default for Tracker telemetry: 47001)
UDP_HOST=127.0.0.1
UDP_PORT=47001

# Tracker Process Management
TRACKER_AUTOSTART=true

# Disable virtual simulated guns (enforce physical hardware only)
TRACKER_NO_SIM=true

# Execution mode: "script" to run Python script, or "exe" to run compiled executable
TRACKER_MODE=script

# Relative paths from Backend directory or absolute paths
TRACKER_SCRIPT_PATH=../Tracker/main.py
TRACKER_EXE_PATH=../Tracker/dist/Tracker.exe

# Custom Python interpreter path (leave empty to auto-detect suite venv ..\.venv)
TRACKER_PYTHON_PATH=../.venv/Scripts/python.exe

# Timeout in seconds to wait for initial telemetry after launch
TRACKER_STARTUP_TIMEOUT=5.0

# Timeout in seconds before telemetry is considered stale
TRACKER_TELEMETRY_TIMEOUT=5.0

# Automatic crash recovery
TRACKER_RESTART_ON_CRASH=true
TRACKER_MAX_CRASH_RESTARTS=3

# Security: restrict process control (start/stop/restart) to localhost clients
LOCAL_ONLY_MANAGEMENT=true

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
